# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_NAME=Sign Language Recognition
NEXT_PUBLIC_APP_VERSION=0.1.0

# Backend Environment Variables
DATABASE_URL=postgresql://user:password@localhost:5432/asl_recognition
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=asl-recognition-uploads
AWS_S3_ENDPOINT_URL=https://s3.amazonaws.com

# File Upload Configuration
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=500
ALLOWED_IMAGE_FORMATS=png,jpg,jpeg,gif
ALLOWED_VIDEO_FORMATS=mp4,avi,mov,mkv

# Model Configuration
MODEL_PATH=./models/asl_model.onnx
MODEL_DEVICE=cuda
BATCH_SIZE=32
INFERENCE_THRESHOLD=0.5

# Server Configuration
FASTAPI_ENV=development
FASTAPI_DEBUG=true
FASTAPI_RELOAD=true
WORKERS=4
PORT=8000
HOST=0.0.0.0

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1
TRUST_PROXY=1

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@aslrecognition.com

# Sentry Error Tracking
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=development

# Redis (for caching)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Admin Configuration
ADMIN_EMAIL=admin@aslrecognition.com
ADMIN_PASSWORD=change-this-password
